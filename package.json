{
  "name": "xiaoxiao-agent",
  "version": "0.6.13",
  "description": "Xiaoxiao Agent — multi-model desktop workspace with generation, visual testing, and Agent workflows",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "icons": "node scripts/icon.js",
    "pack": "electron-builder --dir",
    "dist:mac": "electron-builder --mac dmg",
    "check": "node scripts/check.cjs",
    "trial:phase-one": "node scripts/field-trial.cjs",
    "test:desktop": "node scripts/connection-smoke.cjs && node scripts/metrics-smoke.cjs && node scripts/navigator-smoke.cjs && node scripts/chat-delivery-smoke.cjs && node scripts/presence-smoke.cjs && node scripts/smoke.cjs && node scripts/workflow-smoke.cjs && node scripts/workbench-smoke.cjs && node scripts/generation-smoke.cjs && node scripts/proof-studio-smoke.cjs && node scripts/video-recovery-smoke.cjs && node scripts/theme-smoke.cjs && node scripts/field-trial-smoke.cjs",
    "screenshots": "node scripts/screenshots.cjs",
    "prestart": "npm run build:renderer",
    "prepack": "npm run build:renderer",
    "predist:mac": "npm run build:renderer",
    "pretest:desktop": "npm run build:renderer",
    "prescreenshots": "npm run build:renderer",
    "build:renderer": "node scripts/build-renderer.cjs",
    "release:mac": "node scripts/release-mac.cjs"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.8",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "codemirror": "6.0.2",
    "electron": "45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "0.28.2",
    "lucide-static": "1.76.0",
    "playwright": "^1.65.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ajv": "^8.20.0",
    "diff": "9.0.0",
    "docx": "9.16.0",
    "dompurify": "^3.4.18",
    "js-yaml": "4.3.2",
    "marked": "^18.2.1",
    "node-pty": "1.1.0"
  },
  "author": "Xiaoxiao",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.16"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shamnick/Xiaoxiao-Agent.git"
  },
  "bugs": {
    "url": "https://github.com/Shamnick/Xiaoxiao-Agent/issues"
  },
  "homepage": "https://github.com/Shamnick/Xiaoxiao-Agent#readme",
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.1"
  }
}
